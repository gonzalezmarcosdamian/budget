# ── Telegram ─────────────────────────────────────────────
# Token que te da @BotFather
TELEGRAM_BOT_TOKEN=
# Cadena aleatoria propia. Telegram la reenvía en cada webhook
# y la validamos: sin esto, cualquiera puede postear updates falsos.
# Generar con: php -r "echo bin2hex(random_bytes(32));"
TELEGRAM_WEBHOOK_SECRET=

# ── Base de datos (MySQL de WNPower) ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── Aplicación ───────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_CURRENCY=ARS

# Acceso por invitación: quien no tenga código queda fuera.
INVITE_CODE=

# ── Proveedores de IA (fase 2) ───────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Operaciones de IA por usuario y por mes antes de degradar
# a modo texto. 0 = sin límite.
AI_MONTHLY_QUOTA=200
